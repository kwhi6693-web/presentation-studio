* text=auto
# The installable Skill tree must remain byte-identical to the signed ZIP on
# every platform. Disable checkout-time CRLF conversion for all vendored files.
presentation-studio/** -text
*.zip binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

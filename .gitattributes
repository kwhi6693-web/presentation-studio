* text=auto
# The installable Skill tree must remain byte-identical to the signed ZIP on
# every platform. Disable checkout-time CRLF conversion for all vendored files.
presentation-studio/** -text
*.zip binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
# Vendored upstream engines are imported verbatim, and upstream releases keep shipping
# files with blank lines at EOF (three separate sync outages so far). Allow only that
# one whitespace class inside the imported engine trees. Other whitespace errors
# (including trailing spaces) remain checked there, and every whitespace error
# remains checked for Presentation Studio's own files.
presentation-studio/engines/** whitespace=-blank-at-eof
